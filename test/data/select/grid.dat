grid-template-columns: [a] 10px 10px 1fr
grid-template-rows: auto
grid-auto-rows: 100px
grid-template-areas: x 1/1/2/2 y 1/2/2/3 1x2
grid-auto-flow: column
grid-column-start: 1
grid-column-end: span 2
grid-row-start: y
grid-row-end: y
row-gap: 1em
justify-items: start
justify-self: end
writing-mode: horizontal-tb
z-index: auto
#reset

# explicit inherit, and important
#tree screen
| html
|  div
|   p*
#ua
#user
#author
div { display: block; grid-template-columns: 5px; grid-column-start: 3 x; grid-template-areas: "q"; }
p { display: block; grid-template-columns: inherit !important; grid-column-start: inherit; grid-template-areas: inherit; }
p { grid-template-columns: 7px; }
