# a named font from a chain of variables, with no generic family
#tree
| html
|  div*
#ua
div { display: block; }
#user
#author
html { --fa-family-classic: "Font Awesome 7 Free"; --fa-family: var(--fa-family-classic); }
div { --_fa-family: var(--fa-family, var(--fa-style-family, "Font Awesome 7 Free")); font-family: var(--_fa-family); }
